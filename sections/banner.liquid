{% stylesheet %}
  .banner {
    background-color: {{ section.settings.bg_color }};
    padding: 40px 20px;
    text-align: center;
  }
  .banner h1 {
    margin: 0;
    font-size: 48px;
  }
  .banner p {
    margin: 10px 0 0 0;
    font-size: 18px;
  }
{% endstylesheet %}

<div class="banner">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.subheading }}</p>
</div>

{% schema %}
{
  "name": "Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your tagline here"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
